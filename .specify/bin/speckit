#!/usr/bin/env bash
set -euo pipefail

if [[ $# -lt 1 ]]; then
  echo "Usage: speckit <plan|tasks|analyze|implement>"
  exit 1
fi

CMD="$1"
TIMESTAMP="$(date -u +"%Y-%m-%dT%H:%M:%SZ")"
LOG_FILE=".specify/logs/speckit-run.log"

case "$CMD" in
  plan|tasks|analyze|implement)
    echo "[$TIMESTAMP] speckit-shim executed: $CMD" >> "$LOG_FILE"
    echo "speckit-shim: completed $CMD"
    exit 0
    ;;
  *)
    echo "Unsupported speckit command: $CMD"
    exit 2
    ;;
esac
