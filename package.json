{
  "name": "aerospace-and-defense-verify-clean-restart-submodule-and-bra",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "description": "Repository generated from specification updates (Aerospace and Defense)",
  "scripts": {
    "setup": "bash scripts/bootstrap.sh",
    "db:reset-seed": "bash scripts/db-reset-seed.sh",
    "db:status": "PAGER=cat psql -d aerospace_db -c \"SELECT COUNT(*) AS requirements_count FROM requirements; SELECT COUNT(*) AS user_stories_count FROM user_stories;\"",
    "dev:fresh": "npm run setup && npm run db:reset-seed && npm run dev",
    "lint": "eslint .",
    "dev:backend": "bash -lc 'cd backend && if [ -x ../.venv/bin/python ]; then ../.venv/bin/python run.py; else python3 run.py; fi'",
    "dev:frontend": "ng serve --port 4201 --poll",
    "dev": "concurrently \"npm run dev:backend\" \"npm run dev:frontend\"",
    "build": "ng build",
    "test": "ng test"
  },
  "dependencies": {
    "@angular/animations": "^21.2.11",
    "@angular/common": "^21.2.11",
    "@angular/compiler": "^21.2.11",
    "@angular/core": "^21.2.11",
    "@angular/forms": "^21.2.11",
    "@angular/platform-browser": "^21.2.11",
    "@angular/platform-browser-dynamic": "^21.2.11",
    "@angular/router": "^21.2.11",
    "@aws-sdk/client-cognito-identity": "^3.614.0",
    "@aws-sdk/client-dynamodb": "^3.614.0",
    "@aws-sdk/client-ec2": "^3.614.0",
    "@aws-sdk/client-rds": "^3.614.0",
    "@aws-sdk/client-s3": "^3.614.0",
    "@aws-sdk/credential-providers": "^3.614.0",
    "axios": "^1.7.7",
    "pg": "^8.13.1",
    "rxjs": "^7.8.2",
    "tslib": "^2.7.0"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "^21.2.9",
    "@angular/cli": "^21.2.9",
    "@angular/compiler-cli": "^21.2.11",
    "@types/node": "^20.14.9",
    "concurrently": "^9.2.1",
    "eslint": "^9.0.0",
    "prettier": "^3.3.3",
    "sass": "^1.99.0",
    "speckit": "^0.1.0",
    "typescript": "^6.0.3",
    "zone.js": "^0.16.1"
  }
}
